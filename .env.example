REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:8100,http://localhost:4200

# room-queue-service emite el token; los demás servicios solo lo validan
JWT_SECRET_KEY=reemplazar-por-una-clave-aleatoria-de-al-menos-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=240

CLAVE_SERVICIOS_INTERNOS=reemplazar-por-otra-clave-aleatoria
URL_MUSIC_CATALOG_SERVICE=http://music-catalog-service:8001
URL_ROOM_QUEUE_SERVICE=http://room-queue-service:8002

JAMENDO_CLIENT_ID=
TTL_CACHE_CATALOGO_SEGUNDOS=600
TIEMPO_ESPERA_PROVEEDORES_SEGUNDOS=5

TTL_SALA_INACTIVA_HORAS=2
TTL_SALA_MAXIMA_HORAS=24

# URLs que usa el navegador para llegar a cada servicio
URL_PUBLICA_MUSIC_CATALOG=http://localhost:8001
URL_PUBLICA_ROOM_QUEUE=http://localhost:8002
URL_PUBLICA_REALTIME_SYNC=ws://localhost:8003
